# --- divi-swap landing page (read-only static page; BEGIN) ---
# Exact-match locations beat the /swap/ prefix proxy, so every API path still reaches divi-swapd.
location = /swap/ {
    root /var/www/divi-swap;
    rewrite ^ /index.html break;
    default_type text/html;
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control "no-cache" always;
}
location = /swap/landing.js {
    alias /var/www/divi-swap/landing.js;
    default_type application/javascript;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control "no-cache" always;
}
location = /swap/landing.css {
    alias /var/www/divi-swap/landing.css;
    default_type text/css;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control "no-cache" always;
}
# --- divi-swap landing page (END) ---
