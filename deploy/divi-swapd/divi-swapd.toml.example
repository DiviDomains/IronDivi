# divi-swapd testnet config. Contains references only, never key material.
# Install as /etc/divi-swapd/divi-swapd.toml (root:divi-swapd 0640).
profile = "testnet"          # 6h/3h timeouts, 1 BTC / 3 DIVI confirmations
listen = "127.0.0.1:18480"   # loopback only; takers use an SSH tunnel (nginx /swap/ is opt-in: deploy.sh NGINX=1, DECISIONS #7)
db_path = "/var/lib/divi-swapd/swaps.db"
tick_secs = 10               # scheduler interval for Maker::tick

[divi]
rpc_url = "https://services.divi.domains/api/testnet/rpc/"
key = "credential:maker-divi"   # systemd LoadCredential, see divi-swapd.service
wallet_path = "/var/lib/divi-swapd/divi-wallet.json"  # known UTXOs (public data only)
scan_from_height = 339800

[btc]
network = "signet"
esplora_url = "https://mempool.space/signet/api"
fallback_esplora_url = "https://blockstream.info/signet/api"
key = "credential:maker-btc"

[ltc]
network = "testnet"
esplora_url = "https://litecoinspace.org/testnet/api"
# No independent secondary mirror of this API shape is known (swap-chain-ltc lane status,
# decisions, 2026-10-11); fallback_esplora_url is left unset.
# Testnets reuse the BTC swap key on every secp256k1 chain (docs/plans/swap-poc/funding.md,
# decision 64ae2a0): no maker-ltc 1Password item or credential file exists or is needed —
# this is the same maker-btc credential already loaded above.
key = "credential:maker-btc"

[usdc]
# network defaults to "sepolia" if omitted; "base-sepolia" is the only other option
# (swap_chain_evm::UsdcNetwork). It only picks defaults for rpc_url/token below when they
# are left unset — a single [usdc] section (one Chain::Usdc backend) serves one EVM network
# at a time, so switching network here moves the whole backend, it doesn't add a second one.
network = "sepolia"
rpc_url = "https://ethereum-sepolia-rpc.publicnode.com"
# Placeholder until Erc20Htlc is deployed to Sepolia (orchestrator, funded key) — fill in
# the real address before enabling a usdc offer.
htlc = "0x0000000000000000000000000000000000000000"
# token omitted: defaults to Circle's test USDC for `network` (SEPOLIA_USDC here;
# BASE_SEPOLIA_USDC if network = "base-sepolia").
# funding.md (2026-10-11): EVM reuses the BTC swap key (same secp256k1 pubkey, Ethereum
# address derived from it) — no separate maker-usdc credential.
key = "credential:maker-btc"

[zec]
lightwalletd_url = "https://testnet.zec.rocks:443"
# Same BTC swap key (funding.md); started only while a zec offer below is enabled.
key = "credential:maker-btc"

# Standing offers. Price is DIVI sats per 1 counter-chain coin; min/max are counter-chain
# sats in both directions. direction: "taker_pays_btc" (maker sells DIVI, the default) or
# "taker_pays_divi" (maker sells the counter chain). counter_chain defaults to "btc".
[[offers]]
id = "divi-btc-testnet"
direction = "taker_pays_btc"
divi_sats_per_btc = 300000000000000   # 3,000,000 DIVI per BTC
min_btc_sats = 5000
max_btc_sats = 50000

[[offers]]
id = "btc-divi-testnet"
direction = "taker_pays_divi"
divi_sats_per_btc = 300000000000000
min_btc_sats = 5000
max_btc_sats = 50000

[[offers]]
id = "divi-ltc-testnet"
direction = "taker_pays_btc"
counter_chain = "ltc"
divi_sats_per_btc = 1000000000000     # 10,000 DIVI per LTC
min_btc_sats = 100000
max_btc_sats = 10000000

# Off until the maker's LTC address holds max_btc_sats + fees (the maker locks LTC here;
# see docs/plans/swap-poc/wave4-deploy.md).
[[offers]]
id = "ltc-divi-testnet"
direction = "taker_pays_divi"
counter_chain = "ltc"
enabled = false
divi_sats_per_btc = 1000000000000
min_btc_sats = 100000
max_btc_sats = 10000000

# `enabled = false` (an offer stays in the file but is not served; a counter chain with no
# enabled offer gets no backend). Keep these off until [usdc].htlc above is a real deployed address — min/max are USDC engine
# sats (1e8 per coin; UsdcBackend needs whole multiples of 100 to convert to 1e6 base
# units), so 1000000..100000000 is 0.01..1.00 USDC. Ids say "sepolia" because [usdc].network
# above is "sepolia"; relabel them (e.g. divi-usdc-base-sepolia) if that's switched to
# "base-sepolia" — the id is just an operator-facing label, counter_chain stays "usdc"
# either way, and the single [usdc] section/backend only ever serves one network at a time.
[[offers]]
id = "divi-usdc-sepolia"
direction = "taker_pays_btc"
counter_chain = "usdc"
enabled = false
divi_sats_per_btc = 10000000000       # 100 DIVI per USDC (placeholder)
min_btc_sats = 1000000
max_btc_sats = 100000000

[[offers]]
id = "usdc-divi-sepolia"
direction = "taker_pays_divi"
counter_chain = "usdc"
enabled = false
divi_sats_per_btc = 10000000000
min_btc_sats = 1000000
max_btc_sats = 100000000

# ZEC: off until the maker t-address holds TAZ on the NU7 chain (funding.md). With every zec
# offer disabled the [zec] backend is not started.
[[offers]]
id = "divi-zec-testnet"
direction = "taker_pays_btc"
counter_chain = "zec"
enabled = false
divi_sats_per_btc = 500000000000      # 5,000 DIVI per ZEC
min_btc_sats = 100000
max_btc_sats = 10000000

[[offers]]
id = "zec-divi-testnet"
direction = "taker_pays_divi"
counter_chain = "zec"
enabled = false
divi_sats_per_btc = 500000000000
min_btc_sats = 100000
max_btc_sats = 10000000

# XMR (adaptor-signature swap, divi-swap-xmr): off until the maker has a stagenet
# monerod + monero-wallet-rpc and its own funded DIVI key. Then uncomment [xmr] and enable.
# The maker always sells DIVI here (taker_pays_btc); amounts are in 1e-8 XMR.
[[offers]]
id = "divi-xmr-stagenet"
direction = "taker_pays_btc"
counter_chain = "xmr"
enabled = false
divi_sats_per_btc = 500000000000      # 5,000 DIVI per XMR
min_btc_sats = 100000                 # 0.001 XMR
max_btc_sats = 100000000              # 1 XMR

# [xmr]
# network = "stagenet"
# monerod_url = "http://127.0.0.1:38081"
# wallet_rpc_url = "http://127.0.0.1:38088"
# wallet_rpc_user = "swap"
# wallet_rpc_password = "credential:maker-xmr-wallet-rpc"
# sweep_address = "<the maker wallet's stagenet address>"
# divi_key = "credential:maker-divi-xmr"          # NOT the [divi] key
# divi_wallet_path = "/var/lib/divi-swapd/divi-xmr-wallet.json"
# divi_fund_txids = ["<txid paying that key's address>"]
# lookback_blocks = 720
