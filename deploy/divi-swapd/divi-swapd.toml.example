# divi-swapd testnet config. Contains references only, never key material.
# Install as /etc/divi-swapd/divi-swapd.toml (root:divi-swapd 0640).
profile = "testnet"          # 6h/3h timeouts, 1 BTC / 3 DIVI confirmations
listen = "127.0.0.1:18480"   # nginx proxies /swap/ here
db_path = "/var/lib/divi-swapd/swaps.db"

[divi]
rpc_url = "https://services.divi.domains/api/testnet/rpc/"
key = "credential:maker-divi"   # systemd LoadCredential, see divi-swapd.service

[btc]
network = "signet"
esplora_url = "https://mempool.space/signet/api"
fallback_esplora_url = "https://blockstream.info/testnet/api"
key = "credential:maker-btc"
